generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Domain enums — mirror src/types/calculator.ts for type-safe persistence
// ---------------------------------------------------------------------------

enum GarageSize {
  one_car
  two_car
  three_car
  oversized
}

enum CoatingType {
  epoxy
  polyaspartic
  polyurea
  metallic
  quartz
  not_sure
}

enum FloorCondition {
  excellent
  good
  fair
  poor
}

enum CrackLevel {
  none
  minor
  several
  major
}

enum ExistingCoating {
  none
  paint
  epoxy
}

enum DecorativeFinish {
  none
  standard_flakes
  premium_flakes
}

enum Timeline {
  asap
  within_month
  within_three_months
  flexible
}

enum PreferredContactMethod {
  email
  phone
  text
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Calculation {
  id               String           @id @default(cuid())
  city             String
  squareFeet       Float
  garageSize       GarageSize
  coatingType      CoatingType
  floorCondition   FloorCondition
  crackLevel       CrackLevel
  existingCoating  ExistingCoating
  decorativeFinish DecorativeFinish
  stemWalls        Boolean          @default(false)
  stepsCount       Int              @default(0)
  moistureIssues   Boolean          @default(false)
  timeline         Timeline
  estimatedLow     Float
  estimatedHigh    Float
  recommendedSystem String
  createdAt        DateTime         @default(now())

  lead Lead?
}

model Lead {
  id                     String                 @id @default(cuid())
  calculationId          String                 @unique
  calculation            Calculation            @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  name                   String
  email                  String
  phone                  String
  preferredContactMethod PreferredContactMethod
  createdAt              DateTime               @default(now())
}
