generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String

  city          String

  coatingType   String

  garageSize    String

  estimatedLow  Float
  estimatedHigh Float

  createdAt     DateTime @default(now())
}

model Calculation {
  id            String   @id @default(cuid())

  city          String

  coatingType   String

  garageSize    String

  floorCondition String

  estimateLow   Float
  estimateHigh  Float

  createdAt     DateTime @default(now())
}